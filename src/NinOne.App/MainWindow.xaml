                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock x:Name="HvResultText" Style="{StaticResource ResultStyle}" Text="最近结果：--"/>
                    <TextBlock x:Name="HvErrorText" Style="{StaticResource ResultStyle}" Foreground="{StaticResource Danger}" Text="最近错误：--"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource CardStyle}" Padding="12" VerticalAlignment="Stretch" Grid.Column="2">
              <Expander Header="人工操作日志" IsExpanded="True" Margin="0" VerticalAlignment="Stretch">
                <TextBox x:Name="HvRawText" Style="{StaticResource RawStyle}" Height="Auto" VerticalAlignment="Stretch"/>
              </Expander>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="通讯与日志">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock Text="通讯与操作日志" Style="{StaticResource PageTitleStyle}"/>
          <TextBlock Grid.Row="1" x:Name="LogPathText" Style="{StaticResource PageSubtitleStyle}"/>
          <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" BorderThickness="0" Padding="10"/>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Background="#FFDDE4EA" BorderBrush="#FFCAD4DD" BorderThickness="0,1,0,0" Padding="14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="●" Foreground="{StaticResource Success}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <TextBlock Grid.Column="1" x:Name="GlobalStatusText" Text="就绪。所有通讯均在后台线程执行。" VerticalAlignment="Center" Foreground="#FF42596B"/>
      </Grid>
    </Border>
  </Grid>
  </Viewbox>
</Window>
