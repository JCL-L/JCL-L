<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="NinOne.App.MainWindow" Title="NinOne C# 手动模式" Width="1440" Height="900" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" Closing="OnClosing" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Viewbox Stretch="Uniform" StretchDirection="Both" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
  <Grid Width="1440" Height="860" Background="{StaticResource AppBackground}">
    <Grid.RowDefinitions>
      <RowDefinition Height="64"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="32"/>
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#FF102A3D" Padding="20,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="NinOne 手动控制工作站" Foreground="White" FontSize="21" FontWeight="SemiBold"/>
          <TextBlock x:Name="ConfigSourceText" Foreground="#FFAFC2D0" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="#FF173E56" CornerRadius="4" Padding="12,7" Margin="4">
            <TextBlock Text="真实设备" Foreground="White" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#FF173E56" CornerRadius="4" Padding="12,7" Margin="4">
            <TextBlock Text="无数据库" Foreground="White" FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
      </Grid>
    </Border>
    <TabControl Grid.Row="1" Style="{StaticResource NavTabControlStyle}" TabStripPlacement="Left">
      <TabItem Header="PLC / 接触器">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <TextBlock Text="PLC 与接触器" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="S7 TCP 直连，集中查看并控制 K1～K16 实际输出状态。" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Style="{StaticResource CardStyle}" Grid.Row="1">
            <WrapPanel>
              <TextBlock Style="{StaticResource LabelStyle}" Text="本机 IP"/>
              <TextBox x:Name="PlcPcIpText" Width="125" Text="192.168.4.100"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="PLC IP"/>
              <TextBox x:Name="PlcIpText" Width="125" Text="192.168.4.101"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="端口"/>
              <TextBox x:Name="PlcPortText" Width="70" Text="102"/>
              <Border Style="{StaticResource StatusStyle}">
                <TextBlock x:Name="PlcStatusText" Text="未连接"/>
              </Border>
              <Button Content="连接" Click="PlcConnect_Click" Style="{StaticResource PrimaryButton}"/>
              <Button Content="断开" Click="PlcDisconnect_Click"/>
              <Button Content="刷新 K1～K16" Click="PlcRefresh_Click"/>
              <Button Content="全部关闭" Click="PlcAllOff_Click" Style="{StaticResource DangerButton}"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="连接时应用 · 写后立即回读"/>
            </WrapPanel>
          </Border>
          <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="0" Grid.Row="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border Background="#FFE8EEF4" Padding="12,0">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="90"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="编号" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="地址" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="2" Text="功能" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="3" Text="实际状态" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                  </Border>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <ItemsControl x:Name="RelayItems">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="White" BorderBrush="#FFE2E7EC" BorderThickness="0,0,0,1" Padding="8,4">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding Id}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Text="{Binding Address}" VerticalAlignment="Center" FontFamily="Consolas"/>
                              <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"/>
                              <CheckBox Grid.Column="3" IsChecked="{Binding State}" Content="实际 ON" IsHitTestVisible="False"/>
                              <Button Grid.Column="4" Content="ON" Tag="{Binding}" Click="RelayOn_Click" Style="{StaticResource SuccessButton}"/>
                              <Button Grid.Column="5" Content="OFF" Tag="{Binding}" Click="RelayOff_Click"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>
              <StackPanel Grid.Row="1">
                <TextBlock x:Name="PlcResultText" Style="{StaticResource ResultStyle}" Text="最近结果：--"/>
                <TextBlock x:Name="PlcErrorText" Style="{StaticResource ResultStyle}" Foreground="{StaticResource Danger}" Text="最近错误：--"/>
              </StackPanel>
            </Grid>
            <Border Style="{StaticResource CardStyle}" Padding="12" VerticalAlignment="Stretch" Grid.Column="2">
              <Expander Grid.Row="4" Header="原始 S7 日志" IsExpanded="True" Margin="0" VerticalAlignment="Stretch">
                <TextBox x:Name="PlcRawText" Style="{StaticResource RawStyle}" Height="Auto" VerticalAlignment="Stretch"/>
              </Expander>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="辅助电源 GPD2303S">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="辅助电源 GPD2303S" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="设置通道电压与 ISET 电流上限；支持按 V/s 对指定通道执行有限次数的电压升降循环。" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Style="{StaticResource CardStyle}" Grid.Row="1">
            <WrapPanel>
              <TextBlock Style="{StaticResource LabelStyle}" Text="串口"/>
              <ComboBox x:Name="GpdPortText" Width="100" IsEditable="True"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="波特率"/>
              <ComboBox x:Name="GpdBaudBox" Width="110" IsEditable="True"/>
              <Border Style="{StaticResource StatusStyle}">
                <TextBlock x:Name="GpdStatusText" Text="未连接"/>
              </Border>
              <Button Content="连接" Click="GpdConnect_Click" Style="{StaticResource PrimaryButton}"/>
              <Button Content="断开" Click="GpdDisconnect_Click"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="8N1 · CRLF · 连接时应用"/>
            </WrapPanel>
          </Border>
          <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <StackPanel>
                <GroupBox Header="通道参数与输出控制">
                  <StackPanel>
                    <UniformGrid Columns="3" Margin="0,0,0,6">
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="通道"/>
                        <ComboBox x:Name="GpdChannelBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                          <ComboBoxItem Content="1"/>
                          <ComboBoxItem Content="2"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="电压 (V)"/>
                        <TextBox x:Name="GpdVoltageText" HorizontalAlignment="Stretch" Text="12"/>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="电流上限 (ISET，A)"/>
                        <TextBox x:Name="GpdCurrentText" HorizontalAlignment="Stretch" Text="1"/>
                      </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="4" Margin="0,4,0,0">
                      <Button x:Name="GpdSetButton" Content="写入并回读" Click="GpdSet_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch"/>
                      <Button x:Name="GpdManualOnButton" Content="输出 ON" Click="GpdOn_Click" Style="{StaticResource SuccessButton}"/>
                      <Button x:Name="GpdManualOffButton" Content="输出 OFF" Click="GpdOff_Click" Style="{StaticResource DangerButton}"/>
                      <Button x:Name="GpdReadButton" Content="读取" Click="GpdRead_Click" HorizontalAlignment="Stretch"/>
                    </UniformGrid>
                  </StackPanel>
                </GroupBox>
                <GroupBox Header="循环关断功能">
                  <StackPanel>
                    <UniformGrid Columns="2">
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="ON 持续时间 (ms)"/>
                        <TextBox x:Name="GpdCycleOnMsText" HorizontalAlignment="Stretch" Text="1000"/>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="OFF 持续时间 (ms)"/>
                        <TextBox x:Name="GpdCycleOffMsText" HorizontalAlignment="Stretch" Text="1000"/>
                      </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,4,0,0">
                      <Button x:Name="GpdCycleStartButton" Content="启动循环" Click="GpdCycleStart_Click" Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch"/>
                      <Button x:Name="GpdCycleStopButton" Content="停止循环" Click="GpdCycleStop_Click" Style="{StaticResource DangerButton}" IsEnabled="False" HorizontalAlignment="Stretch"/>
                    </UniformGrid>
                    <TextBlock x:Name="GpdCycleStatusText" Style="{StaticResource LabelStyle}" Text="循环状态：已停止"/>
                    <TextBlock Text="启动后按 ON 保持时间 → OFF 保持时间持续循环；停止循环时输出安全关闭。" Foreground="{StaticResource TextSecondary}" Margin="8,4" TextWrapping="Wrap"/>
                  </StackPanel>
                </GroupBox>
                <GroupBox Header="电压升降循环">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="3">
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="斜坡通道"/>
                        <ComboBox x:Name="GpdRampChannelBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                          <ComboBoxItem Content="1"/>
                          <ComboBoxItem Content="2"/>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="上升目标电压 (V)"/>
                        <TextBox x:Name="GpdRampHighVoltageText" HorizontalAlignment="Stretch" Text="24"/>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="下降目标电压 (V)"/>
                        <TextBox x:Name="GpdRampLowVoltageText" HorizontalAlignment="Stretch" Text="12"/>
                      </StackPanel>
                    </UniformGrid>
                    <UniformGrid Grid.Row="1" Columns="3">
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="上升速率 (V/s)"/>
                        <TextBox x:Name="GpdRampRiseRateText" HorizontalAlignment="Stretch" Text="1"/>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="下降速率 (V/s)"/>
                        <TextBox x:Name="GpdRampFallRateText" HorizontalAlignment="Stretch" Text="1"/>
                      </StackPanel>
                      <StackPanel Margin="4">
                        <TextBlock Style="{StaticResource LabelStyle}" Text="循环次数"/>
                        <TextBox x:Name="GpdRampCycleCountText" HorizontalAlignment="Stretch" Text="1"/>
                      </StackPanel>
                    </UniformGrid>
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,4,0,0">
                      <Button x:Name="GpdRampStartButton" Content="启动电压循环" Click="GpdRampStart_Click" Style="{StaticResource SuccessButton}" HorizontalAlignment="Stretch"/>
                      <Button x:Name="GpdRampStopButton" Content="停止电压循环" Click="GpdRampStop_Click" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" IsEnabled="False"/>
                    </UniformGrid>
                    <TextBlock Grid.Row="3" x:Name="GpdRampStatusText" Style="{StaticResource LabelStyle}" Text="电压循环：已停止"/>
                    <TextBlock Grid.Row="4" Text="启动后先按对应速率平滑到下降目标，再执行“下降目标 → 上升目标 → 下降目标”；达到设定次数后停在下降目标。只改变所选通道 VSET，保持当前 ISET 和输出 ON/OFF 状态不变。" Foreground="{StaticResource TextSecondary}" Margin="8,4" TextWrapping="Wrap"/>
                  </Grid>
                </GroupBox>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="操作结果" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock x:Name="GpdResultText" Style="{StaticResource ResultStyle}" Text="最近结果：--"/>
                    <TextBlock x:Name="GpdErrorText" Style="{StaticResource ResultStyle}" Foreground="{StaticResource Danger}" Text="最近错误：--"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="3*"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource CardStyle}" Padding="12">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="辅助电源开关时间记录" Style="{StaticResource SectionTitleStyle}"/>
                  <TextBlock Grid.Row="1" Text="记录写后回读确认时间，精确到毫秒；与原始串口日志分开显示。" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8" TextWrapping="Wrap"/>
                  <ListBox Grid.Row="2" x:Name="GpdSwitchRecordList" FontFamily="Consolas" FontSize="12" BorderBrush="{StaticResource SurfaceBorder}" Padding="6"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" VerticalAlignment="Stretch">
                <Expander Header="原始串口日志" IsExpanded="True" Margin="0" VerticalAlignment="Stretch">
                  <TextBox x:Name="GpdRawText" Style="{StaticResource RawStyle}" Height="Auto" VerticalAlignment="Stretch"/>
                </Expander>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="低压负载 N69206">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="低压电子负载 N69206" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="连接地址和 CC、CV、CR、CP 量程均在当前页面设置。" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Style="{StaticResource CardStyle}" Grid.Row="1">
            <WrapPanel>
              <TextBlock Style="{StaticResource LabelStyle}" Text="IP"/>
              <TextBox x:Name="LoadIpText" Width="125" Text="192.168.4.102"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="端口"/>
              <TextBox x:Name="LoadPortText" Width="70" Text="7000"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="设备 ID"/>
              <TextBox x:Name="LoadDeviceIdText" Width="60" Text="160"/>
              <Border Style="{StaticResource StatusStyle}">
                <TextBlock x:Name="LoadStatusText" Text="未连接"/>
              </Border>
              <Button Content="连接" Click="LoadConnect_Click" Style="{StaticResource PrimaryButton}"/>
              <Button Content="断开" Click="LoadDisconnect_Click"/>
              <TextBlock x:Name="LoadConfigText" Style="{StaticResource LabelStyle}" Text="连接时应用"/>
            </WrapPanel>
          </Border>
          <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <StackPanel>
                <GroupBox Header="模式量程">
                  <WrapPanel>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="CC"/>
                    <ComboBox x:Name="LoadCcRangeBox" Width="125" SelectionChanged="LoadRangeBox_SelectionChanged"/>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="CV"/>
                    <ComboBox x:Name="LoadCvRangeBox" Width="125" SelectionChanged="LoadRangeBox_SelectionChanged"/>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="CR"/>
                    <ComboBox x:Name="LoadCrRangeBox" Width="125" SelectionChanged="LoadRangeBox_SelectionChanged"/>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="CP"/>
                    <ComboBox x:Name="LoadCpRangeBox" Width="125" SelectionChanged="LoadRangeBox_SelectionChanged"/>
                  </WrapPanel>
                </GroupBox>
                <GroupBox Header="模式参数">
                  <StackPanel>
                    <WrapPanel>
                      <TextBlock Style="{StaticResource LabelStyle}" Text="模式"/>
                      <ComboBox x:Name="LoadModeBox" Width="170" SelectionChanged="LoadModeBox_SelectionChanged"/>
                      <TextBlock x:Name="LoadValueLabel" Style="{StaticResource LabelStyle}" Text="Current"/>
                      <TextBox x:Name="LoadValueText" Width="130" Text="1"/>
                      <TextBlock x:Name="LoadValueUnitText" Style="{StaticResource LabelStyle}" Text="A"/>
                      <TextBlock Style="{StaticResource LabelStyle}" Text="当前量程"/>
                      <Border Background="#FFEAF3F8" CornerRadius="3" Padding="8,0" Margin="4">
                        <TextBlock x:Name="LoadRangeText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </Border>
                    </WrapPanel>
                    <WrapPanel x:Name="LoadSlopePanel">
                      <TextBlock Style="{StaticResource LabelStyle}" Text="上升斜率"/>
                      <TextBox x:Name="LoadRiseText" Width="130" Text="1"/>
                      <TextBlock Style="{StaticResource LabelStyle}" Text="下降斜率"/>
                      <TextBox x:Name="LoadFallText" Width="130" Text="1"/>
                    </WrapPanel>
                    <WrapPanel x:Name="LoadVoltageRatePanel" Visibility="Collapsed">
                      <TextBlock Style="{StaticResource LabelStyle}" Text="V-Rate"/>
                      <ComboBox x:Name="LoadVoltageRateBox" Width="180" SelectionChanged="LoadVoltageRateBox_SelectionChanged"/>
                      <TextBlock x:Name="LoadCustomRateLabel" Style="{StaticResource LabelStyle}" Text="自定义 V/ms" Visibility="Collapsed"/>
                      <TextBox x:Name="LoadCustomRateText" Width="130" Text="1" Visibility="Collapsed"/>
                    </WrapPanel>
                    <WrapPanel Margin="0,8,0,0">
                      <Button Content="应用模式参数" Click="LoadConfigure_Click" Style="{StaticResource PrimaryButton}"/>
                      <Button Content="加载 ON" Click="LoadOn_Click" Style="{StaticResource SuccessButton}"/>
                      <Button Content="加载 OFF" Click="LoadOff_Click" Style="{StaticResource DangerButton}"/>
                      <Button Content="读取测量" Click="LoadRead_Click"/>
                    </WrapPanel>
                  </StackPanel>
                </GroupBox>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="实时测量与结果" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock x:Name="LoadResultText" Style="{StaticResource ResultStyle}" Text="最近结果：--"/>
                    <TextBlock x:Name="LoadErrorText" Style="{StaticResource ResultStyle}" Foreground="{StaticResource Danger}" Text="最近错误：--"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource CardStyle}" Padding="12" VerticalAlignment="Stretch" Grid.Column="2">
              <Expander Header="原始 TCP / Modbus RTU 日志" IsExpanded="True" Margin="0" VerticalAlignment="Stretch">
                <TextBox x:Name="LoadRawText" Style="{StaticResource RawStyle}" Height="Auto" VerticalAlignment="Stretch"/>
              </Expander>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="万用表 GDM9061">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="万用表 GDM9061" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="测量功能与合法量程联动选择。" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Style="{StaticResource CardStyle}" Grid.Row="1">
            <WrapPanel>
              <TextBlock Style="{StaticResource LabelStyle}" Text="串口"/>
              <ComboBox x:Name="DmmPortText" Width="100" IsEditable="True"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="波特率"/>
              <ComboBox x:Name="DmmBaudBox" Width="110" IsEditable="True"/>
              <Border Style="{StaticResource StatusStyle}">
                <TextBlock x:Name="DmmStatusText" Text="未连接"/>
              </Border>
              <Button Content="连接" Click="DmmConnect_Click" Style="{StaticResource PrimaryButton}"/>
              <Button Content="断开" Click="DmmDisconnect_Click"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="8N1 · CRLF · 连接时应用"/>
            </WrapPanel>
          </Border>
          <Grid Grid.Row="2" ClipToBounds="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
              <StackPanel>
                <GroupBox Header="测量设置">
                  <WrapPanel>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="测量功能"/>
                    <ComboBox x:Name="DmmFunctionBox" Width="230" SelectionChanged="DmmFunctionBox_SelectionChanged"/>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="量程"/>
                    <ComboBox x:Name="DmmRangeBox" Width="210"/>
                    <Button Content="应用配置" Click="DmmConfigure_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button Content="读取一次" Click="DmmRead_Click"/>
                  </WrapPanel>
                </GroupBox>
                <Border Style="{StaticResource CardStyle}">
                  <StackPanel>
                    <TextBlock Text="测量结果" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock x:Name="DmmResultText" Style="{StaticResource ResultStyle}" Text="最近结果：--"/>
                    <TextBlock x:Name="DmmErrorText" Style="{StaticResource ResultStyle}" Foreground="{StaticResource Danger}" Text="最近错误：--"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
            <Border Style="{StaticResource CardStyle}" Padding="12" VerticalAlignment="Stretch" Grid.Column="2">
              <Expander Header="原始串口 / SCPI 日志" IsExpanded="True" Margin="0" VerticalAlignment="Stretch">
                <TextBox x:Name="DmmRawText" Style="{StaticResource RawStyle}" Height="Auto" VerticalAlignment="Stretch"/>
              </Expander>
            </Border>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="功率计 PA333H">
        <Grid Margin="20">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="功率计 PA333H" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="配置源侧与输出侧通道，支持一次读取和可停止的连续读取。" Style="{StaticResource PageSubtitleStyle}"/>
          </StackPanel>
          <Border Style="{StaticResource CardStyle}" Grid.Row="1">
            <WrapPanel>
              <TextBlock Style="{StaticResource LabelStyle}" Text="串口"/>
              <ComboBox x:Name="PowerPortText" Width="100" IsEditable="True"/>
              <TextBlock Style="{StaticResource LabelStyle}" Text="波特率"/>
              <ComboBox x:Name="PowerBaudBox" Width="110" IsEditable="True"/>
              <Border Style="{StaticResource StatusStyle}">
                <TextBlock x:Name="PowerStatusText" Text="未连接"/>
              </Border>
              <Button Content="连接" Click="PowerConnect_Click" Style="{StaticResource PrimaryButton}"/>
